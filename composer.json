{
	"name": "tenantcloud/laravel-graphql-platform",
	"description": "Platform for writing GraphQL APIs with Laravel",
	"license": "MIT",
	"require": {
		"php": ">=8.2",
		"webonyx/graphql-php": "^15.3.1",
		"thecodingmachine/graphqlite": "^8.1.1",
		"illuminate/contracts": "^12.0",
		"illuminate/support": "^12.0",
		"illuminate/database": "^12.0",
		"illuminate/console": "^12.0",
		"illuminate/container": "^12.0",
		"illuminate/cache": "^12.0",
		"symfony/validator": "^7.0",
		"symfony/cache": "^7.0",
		"symfony/property-access": "^7.0",
		"symfony/psr-http-message-bridge": "^v7.0",
		"laminas/laminas-diactoros": "^3.0",
		"tenantcloud/php-standard": "^2.3.0",
		"tenantcloud/laravel-api-versioning": "^2.0",
		"sokil/php-isocodes": "^4.2",
		"sokil/php-isocodes-db-only": "^4.0",
		"giggsey/libphonenumber-for-php": "^8.13",
		"league/uri": "^7.5"
	},
	"require-dev": {
		"pestphp/pest": "^3.8",
		"php-cs-fixer/shim": "^3.54",
		"tenantcloud/php-cs-fixer-rule-sets": "~3.4.1",
		"phpstan/phpstan": "^2.1.17",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-webmozart-assert": "^2.0",
		"phpstan/phpstan-mockery": "^2.0",
		"orchestra/testbench": "^10.0",
		"ecodev/graphql-upload": "^7.0",
		"nunomaduro/larastan": "^3.0",
		"laravel/octane": "^2.6",
		"phpbench/phpbench": "^1.4"
	},
	"suggest": {
		"ecodev/graphql-upload": "^7.0"
	},
	"autoload": {
		"psr-4": {
			"TenantCloud\\GraphQLPlatform\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"test-print-schema": "vendor/bin/testbench graphql:print ../../../../tests/Fixtures/schema.gql",
		"test": "vendor/bin/pest",
		"coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage-html coverage",
		"cs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix -v --show-progress=dots",
		"phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
		"testbench": "vendor/bin/testbench",
		"benchmark": [
			"Composer\\Config::disableProcessTimeout",
			"vendor/bin/phpbench run tests/Benchmark"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"allow-plugins": {
			"pestphp/pest-plugin": true
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"TenantCloud\\GraphQLPlatform\\GraphQLPlatformServiceProvider"
			]
		}
	}
}
